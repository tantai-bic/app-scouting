  {
   "id": 18,
   "type": "timeseries",
   "title": "Cầu theo ngày: median tăng installs/ngày mỗi app (top 10 mỗi ngách)",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "${DS_SCOUTING}"
   },
   "gridPos": {
    "x": 0,
    "y": 26,
    "w": 24,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "${DS_SCOUTING}"
     },
     "rawSql": "select date::timestamp as time, niche as metric, percentile_cont(0.5) within group (order by growth) as value\nfrom scouting.market_app where $__timeFilter(date) and growth is not null and niche <> 'Khác' group by 1, 2 order by 1",
     "format": "time_series",
     "rawQuery": true,
     "editorMode": "code"
