      "type": "grafana-postgresql-datasource",
      "uid": "${DS_SCOUTING}"
     },
     "rawSql": "select global as \"Số nước TB\", demand as \"Cầu\", grp as \"Nhóm\" from scouting.market_group\nwhere level = '$mcap' and score is not null",
     "format": "table",
     "rawQuery": true,
