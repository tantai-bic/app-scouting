 "panels": [
  {
   "id": 14,
   "type": "row",
   "title": "Thị trường ngách — top 10 app mỗi $mcap × Top Free 200 của 8 nước",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 15,
   "type": "table",
   "title": "Xếp hạng nên làm theo $mcap",
   "description": "Điểm 0-100 = hạng phần trăm có trọng số: Cầu ×1, Toàn cầu (số nước) ×1, App thắng ×2, Thói quen ×2, IAA ×1 (docs/tieu-chi-chon-ngach.md). Cầu: lịch sử < 7 ngày dùng TB vòng đời, từ 7 ngày là tăng installs/ngày thật. App thắng = app < 2 năm, có ads, không big dev, >= 5k/ngày. Ngách có cột Loại không được chấm điểm.",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "${DS_SCOUTING}"
   },
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 24,
    "h": 14
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "${DS_SCOUTING}"
     },
     "rawSql": "select grp as \"Nhóm\", score as \"Điểm\", demand as \"Cầu: DL/ngày/app\", global as \"Số nước TB\",\n  winners as \"App thắng\", habit as \"% review thói quen\", iaa as \"% có ads\", new_share as \"% app < 2 năm\",\n  rating as \"Rating\", apps as \"Số app\", days as \"Lịch sử (ngày)\", nullif(policy, '') as \"Loại (chính sách)\", top as \"Top 3 app\"\nfrom scouting.market_group where level = '$mcap' order by score desc nulls last, demand desc",
     "format": "table",
     "rawQuery": true,
     "editorMode": "code"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 0,
     "color": {
      "mode": "continuous-RdYlGr"
     },
     "fieldMinMax": true,
     "custom": {
      "cellOptions": {
       "type": "color-background",
       "mode": "gradient"
      },
      "align": "auto"
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byRegexp",
       "options": "^(Nhóm|Loại \\(chính sách\\)|Top 3 app|Lịch sử \\(ngày\\)|Số app)$"
      },
      "properties": [
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "auto"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Nhóm"
      },
      "properties": [
       {
        "id": "custom.minWidth",
        "value": 200
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Top 3 app"
      },
      "properties": [
       {
        "id": "custom.minWidth",
        "value": 420
       }
      ]
     },
     {
      "matcher": {
       "id": "byRegexp",
       "options": "^(% review thói quen|% có ads|% app < 2 năm)$"
      },
      "properties": [
       {
        "id": "unit",
        "value": "percentunit"
       },
       {
        "id": "decimals",
        "value": 0
       }
      ]
     },
     {
      "matcher": {
       "id": "byRegexp",
       "options": "^(Số nước TB|Rating)$"
      },
      "properties": [
       {
        "id": "decimals",
        "value": 1
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "% review thói quen"
      },
      "properties": [
       {
        "id": "decimals",
        "value": 1
       }
      ]
     }
    ]
   },
   "options": {
    "showHeader": true,
    "cellHeight": "sm"
   }
  },
  {
   "id": 16,
   "type": "barchart",
   "title": "Điểm nên làm theo $mcap",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "${DS_SCOUTING}"
   },
   "gridPos": {
    "x": 0,
    "y": 15,
    "w": 12,
    "h": 11
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "${DS_SCOUTING}"
     },
     "rawSql": "select grp as \"Nhóm\", score as \"Điểm\" from scouting.market_group where level = '$mcap' and score is not null order by score desc",
     "format": "table",
     "rawQuery": true,
     "editorMode": "code"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "continuous-RdYlGr"
     },
     "min": 0,
     "max": 100
    },
    "overrides": []
   },
   "options": {
    "orientation": "horizontal",
    "xField": "Nhóm",
    "colorByField": "Điểm",
    "showValue": "always",
    "legend": {
     "showLegend": false
    }
   }
  },
  {
   "id": 17,
   "type": "xychart",
   "title": "Toàn cầu (X: số nước TB) vs Cầu (Y: DL/ngày/app)",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "${DS_SCOUTING}"
