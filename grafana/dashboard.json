     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "${DS_SCOUTING}"
     },
     "rawSql": "select split_part(grp, ' (', 1) as app, growth as \"Tăng/ngày\" from scouting.app_window\nwhere moc_order = 1 and level = 'App' and niche in (${niche:sqlstring}) and category in (${category:sqlstring}) order by growth desc limit 15",
     "format": "table",
