     "rawSql": "select grp as \"App\", max(niche) as \"Ngách\", max(category) as \"Category\", max(growth) filter (where moc_order = 1) as \"7 ngày\", max(growth) filter (where moc_order = 2) as \"30 ngày\", max(growth) filter (where moc_order = 3) as \"Lifetime\",\n  max(pct) filter (where moc_order = 1) as \"% 7 ngày\", max(installs) as \"Tổng installs\"\nfrom scouting.app_window where level = 'App' and niche in (${niche:sqlstring}) and category in (${category:sqlstring}) group by grp order by 4 desc nulls last",
     "format": "table",
     "rawQuery": true,
     "editorMode": "code"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 0,
     "color": {
      "mode": "continuous-RdYlGr"
