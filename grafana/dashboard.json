   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "${DS_SCOUTING}"
     },
     "rawSql": "select date::timestamp as time, niche as metric, sum(growth) as value from scouting.app_daily\nwhere $__timeFilter(date) and niche in (${niche:sqlstring}) and growth is not null group by 1, 2 order by 1",
     "format": "time_series",
     "rawQuery": true,
     "editorMode": "code"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
