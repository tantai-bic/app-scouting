  "from": "now-60d",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "cap",
    "label": "Heatmap theo",
    "type": "custom",
    "query": "Ngách,Category,Genre",
    "current": {
     "text": "Ngách",
     "value": "Ngách"
    },
    "options": [
     {
      "text": "Ngách",
      "value": "Ngách",
      "selected": true
     },
     {
      "text": "Category",
      "value": "Category",
      "selected": false
     },
     {
      "text": "Genre",
      "value": "Genre",
      "selected": false
     }
    ]
   },
   {
    "name": "niche",
    "label": "Ngách",
    "type": "query",
    "datasource": {
     "type": "grafana-postgresql-datasource",
     "uid": "${DS_SCOUTING}"
    },
    "query": "select distinct niche from scouting.app_daily order by 1",
    "definition": "select distinct niche from scouting.app_daily order by 1",
    "refresh": 1,
    "multi": true,
    "includeAll": true,
    "current": {
     "text": "All",
     "value": "$__all"
    },
    "sort": 1
   },
   {
    "name": "category",
    "label": "Category",
    "type": "query",
    "datasource": {
     "type": "grafana-postgresql-datasource",
     "uid": "${DS_SCOUTING}"
    },
    "query": "select distinct category from scouting.app_daily order by 1",
    "definition": "select distinct category from scouting.app_daily order by 1",
    "refresh": 1,
    "multi": true,
    "includeAll": true,
    "current": {
     "text": "All",
     "value": "$__all"
    },
    "sort": 1
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "type": "row",
   "title": "Heatmap theo $cap — 7 ngày / 30 ngày / Lifetime",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 2,
   "type": "table",
   "title": "Tăng installs/ngày theo $cap",
   "description": "Tổng tốc độ tăng installs/ngày của các app trong nhóm. Lifetime = installs ÷ tuổi app.",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "${DS_SCOUTING}"
   },
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 12,
    "h": 10
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "${DS_SCOUTING}"
     },
     "rawSql": "select grp as \"Nhóm\", max(growth) filter (where moc_order = 1) as \"7 ngày\", max(growth) filter (where moc_order = 2) as \"30 ngày\", max(growth) filter (where moc_order = 3) as \"Lifetime\", max(apps) filter (where moc_order = 3) as \"Số app\"\nfrom scouting.app_window where level = '$cap' group by grp order by 2 desc nulls last",
     "format": "table",
     "rawQuery": true,
     "editorMode": "code"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 0,
     "color": {
      "mode": "continuous-RdYlGr"
     },
     "fieldMinMax": true,
     "custom": {
      "cellOptions": {
       "type": "color-background",
       "mode": "gradient"
      },
      "align": "auto"
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byRegexp",
       "options": "^(Nhóm|App|Ngách|Category|Số app|Tổng installs)$"
      },
      "properties": [
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "auto"
        }
       },
       {
        "id": "unit",
        "value": "short"
       }
      ]
     },
     {
      "matcher": {
       "id": "byRegexp",
       "options": "^(Nhóm|App)$"
      },
      "properties": [
       {
        "id": "custom.minWidth",
        "value": 240
       }
      ]
     }
    ]
   },
   "options": {
    "showHeader": true,
    "cellHeight": "sm"
   }
  },
  {
   "id": 3,
   "type": "table",
   "title": "Tăng/ngày mỗi app theo $cap",
   "description": "Tăng/ngày ÷ số app — so ngách đông app với ngách ít app.",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "${DS_SCOUTING}"
   },
   "gridPos": {
    "x": 12,
    "y": 1,
    "w": 12,
    "h": 10
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "${DS_SCOUTING}"
     },
     "rawSql": "select grp as \"Nhóm\", max(growth_per_app) filter (where moc_order = 1) as \"7 ngày\", max(growth_per_app) filter (where moc_order = 2) as \"30 ngày\", max(growth_per_app) filter (where moc_order = 3) as \"Lifetime\"\nfrom scouting.app_window where level = '$cap' group by grp order by 2 desc nulls last",
     "format": "table",
     "rawQuery": true,
     "editorMode": "code"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 0,
     "color": {
      "mode": "continuous-RdYlGr"
     },
     "fieldMinMax": true,
     "custom": {
      "cellOptions": {
       "type": "color-background",
       "mode": "gradient"
      },
      "align": "auto"
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byRegexp",
       "options": "^(Nhóm|App|Ngách|Category|Số app|Tổng installs)$"
      },
      "properties": [
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "auto"
        }
       },
       {
        "id": "unit",
        "value": "short"
       }
      ]
     },
     {
      "matcher": {
       "id": "byRegexp",
       "options": "^(Nhóm|App)$"
      },
      "properties": [
       {
        "id": "custom.minWidth",
        "value": 240
       }
      ]
     }
    ]
   },
   "options": {
    "showHeader": true,
    "cellHeight": "sm"
   }
