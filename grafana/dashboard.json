  {
   "id": 10,
   "type": "timeseries",
   "title": "Tăng installs/ngày theo ngách",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "${DS_SCOUTING}"
   },
   "gridPos": {
    "x": 0,
    "y": 37,
    "w": 12,
    "h": 10
