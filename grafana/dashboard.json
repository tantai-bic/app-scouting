  {
   "id": 4,
   "type": "table",
   "title": "% tăng trong kỳ theo $cap",
   "description": "Δ installs ÷ installs đầu kỳ, quy về đúng 7 / 30 ngày — tăng nhanh so với quy mô.",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "${DS_SCOUTING}"
   },
   "gridPos": {
    "x": 0,
    "y": 11,
    "w": 12,
    "h": 10
