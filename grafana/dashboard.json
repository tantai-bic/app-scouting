     "rawSql": "select grp as \"Nhóm\", max(pct) filter (where moc_order = 1) as \"7 ngày\", max(pct) filter (where moc_order = 2) as \"30 ngày\"\nfrom scouting.app_window where level = '$cap' group by grp order by 2 desc nulls last",
     "format": "table",
     "rawQuery": true,
     "editorMode": "code"
