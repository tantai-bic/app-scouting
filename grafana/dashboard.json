  {
   "name": "DS_SCOUTING",
   "label": "Supabase scouting",
   "type": "datasource",
   "pluginId": "grafana-postgresql-datasource",
   "pluginName": "PostgreSQL"
  }
 ],
 "uid": "app-scouting",
 "title": "App Scouting — Dream 100",
 "tags": [
  "scouting"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "editable": true,
